#!/bin/zsh --no-rcs
set -e

# launchd opens the daemon's StandardOutPath before checkin runs, so the
# directory must exist before the daemon's first launch.
/bin/mkdir -p "/Library/Managed Encryption/logs"

/Library/Crypt/checkin auth-mechs install

TARGET="${3%/}"

# Replace a running launchd job with the one on disk. bootout returns before
# launchd has finished tearing the old job down, so wait for it to go, then
# bootstrap, retrying once. Never fails the install.
reload_daemon() {
    local label="$1" plist="$2" output i
    /bin/launchctl bootout "system/${label}" 2>/dev/null || true
    # A job unloaded with `launchctl unload -w` (or `disable`) stays on
    # launchd's disabled list, and bootstrap then fails with error 5. Before
    # this pkg dropped its restart, the reboot hid that; clear it explicitly.
    /bin/launchctl enable "system/${label}" 2>/dev/null || true
    for i in {1..10}; do
        /bin/launchctl print "system/${label}" >/dev/null 2>&1 || break
        /bin/sleep 0.5
    done
    for i in 1 2; do
        if output=$(/bin/launchctl bootstrap system "${plist}" 2>&1); then
            echo "Loaded ${label}"
            return 0
        fi
        /bin/sleep 1
    done
    echo "WARNING: launchctl bootstrap failed for ${label}: ${output}"
    return 0
}

# The login plugin needs no reload: SecurityAgent loads Crypt.bundle afresh at
# each login, so the new build takes effect at the next one. checkin is a
# LaunchDaemon, so reload it here and the new binary runs now rather than at
# the next start-up. That is why this package asks for no restart.
CHECKIN_LABEL="com.grahamgilbert.crypt"
CHECKIN_PLIST="${TARGET}/Library/LaunchDaemons/${CHECKIN_LABEL}.plist"
if [[ -z "${TARGET}" && -f "${CHECKIN_PLIST}" ]]; then
    /bin/chmod 644 "${CHECKIN_PLIST}" || true
    /usr/sbin/chown root:wheel "${CHECKIN_PLIST}" || true
    reload_daemon "${CHECKIN_LABEL}" "${CHECKIN_PLIST}"
fi

# Managed Encryption Escrow: the Prefs / Run / Logs window and its privileged
# helper ship in this package. Nothing below may fail the install: the login
# plugin is already registered, and the window is optional.
APP_PATH="${TARGET}/Applications/Utilities/Managed Encryption Escrow.app"
HELPER_LABEL="com.grahamgilbert.crypt.helper"
HELPER_PLIST="${TARGET}/Library/LaunchDaemons/${HELPER_LABEL}.plist"
HELPER_MIN_MACOS=14

# The window used to ship as its own package. Its files now belong to this
# package, so drop the old receipt rather than leave two owners of one app.
if /usr/sbin/pkgutil --volume "${TARGET:-/}" --pkg-info com.grahamgilbert.crypt.gui >/dev/null 2>&1; then
    /usr/sbin/pkgutil --volume "${TARGET:-/}" --forget com.grahamgilbert.crypt.gui >/dev/null 2>&1 \
        && echo "Forgot the old com.grahamgilbert.crypt.gui receipt" \
        || echo "WARNING: could not forget the old com.grahamgilbert.crypt.gui receipt"
fi

if [[ ! -f "${HELPER_PLIST}" ]]; then
    echo "WARNING: ${HELPER_PLIST} is missing; the escrow window cannot run checkin"
    exit 0
fi
/bin/chmod 644 "${HELPER_PLIST}"
/usr/sbin/chown root:wheel "${HELPER_PLIST}"

if [[ -n "${TARGET}" ]]; then
    echo "Installed to ${TARGET}; the escrow helper loads at that volume's next start-up"
    exit 0
fi

/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister "${APP_PATH}" 2>/dev/null || true

# The window and helper need macOS 14; checkin and the plugin do not. On an
# older Mac leave the helper unloaded instead of refusing the whole install.
os_major=$(/usr/bin/sw_vers -productVersion | /usr/bin/cut -d. -f1)
if (( os_major < HELPER_MIN_MACOS )); then
    echo "macOS ${os_major} is older than ${HELPER_MIN_MACOS}; the escrow helper is not loaded"
    /bin/launchctl bootout "system/${HELPER_LABEL}" 2>/dev/null || true
    exit 0
fi

# Restart the helper so it runs the binary just installed.
reload_daemon "${HELPER_LABEL}" "${HELPER_PLIST}"
exit 0

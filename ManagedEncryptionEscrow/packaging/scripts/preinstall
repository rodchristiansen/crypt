#!/bin/zsh --no-rcs
# Managed Encryption Escrow preinstall
# Refuses the install on a macOS older than the binaries are built for. Keep
# MINIMUM_MACOS equal to the platform in Package.swift and LSMinimumSystemVersion
# in packaging/resources/Info.plist.template.

MINIMUM_MACOS=14

CURRENT=$(/usr/bin/sw_vers -productVersion)
MAJOR=${CURRENT%%.*}

if (( MAJOR < MINIMUM_MACOS )); then
    echo "Managed Encryption Escrow requires macOS ${MINIMUM_MACOS} or later; this Mac runs ${CURRENT}." >&2
    exit 1
fi

exit 0
